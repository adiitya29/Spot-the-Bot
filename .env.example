# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-in-prod
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Databases & Redis
DATABASE_URL=postgres://spotbot:spotbot@postgres:5432/spotbot
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# LLM & Bot Engine
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=fake
BOT_ENABLED=True
BOT_MAX_CALLS_PER_ROUND=25
BOT_DAILY_CALLS_PER_IP=200

# Observability & Origins
SENTRY_DSN=
FRONTEND_ORIGIN=http://localhost:5173

# Frontend Dev Proxy Targets (override for local non-Docker runs)
VITE_API_TARGET=http://backend:8000
VITE_WS_TARGET=ws://backend:8000

